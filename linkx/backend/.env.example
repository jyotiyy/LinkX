# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/linkx"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="replace_with_secure_secret"

# JWT expiry (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN="7d"

# Port the API server listens on
PORT=3000

# Origin allowed to call this API (CORS)
FRONTEND_URL="http://localhost:5173"

# Base URL used to build short URLs returned to clients
SHORT_URL_BASE="http://localhost:3000"

# Node environment
NODE_ENV="development"
